.env
.venv/
# Semantic_Analysis/artifacts/ is intentionally committed (not gitignored) so
# clones don't need to run 01_build_index.py (up to 25 min) before working -
# important for SIH demo reliability. Re-run the build and recommit if
# IS_Standards_Data/standards.csv or Semantic_Analysis/data/scope_text.csv
# changes; the loader detects a stale fingerprint and falls back to
# keyword-only rather than erroring, so a missed recommit degrades quietly
# instead of breaking.
# Measurement outputs in the same folder are per-run results, not index files.
Semantic_Analysis/artifacts/eval_results*.csv
Semantic_Analysis/artifacts/vocabulary_ablation.csv
# Scrape caches: re-fetchable, and large.
Semantic_Analysis/cache_preview
Semantic_Analysis/cache_tenders/
__pycache__/
*.pyc
CLAUDE.md
*.log
